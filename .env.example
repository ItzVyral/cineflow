# --- CineFlow ---------------------------------------------------------------
# Copie ce fichier en .env et renseigne les valeurs. Ne commit jamais .env.

# Serveur
# Laisser vide pour prendre le premier port libre à partir de 3000
PORT=
NODE_ENV=development
# À mettre à 1 derrière un reverse proxy de confiance (nginx, Caddy…).
TRUST_PROXY=0
# Dossier de la base SQLite (créé automatiquement).
DATA_DIR=data

# --- API HeiwaStream --------------------------------------------------------
# Clé fournie par HeiwaStream (partenaire). Ne la diffuse jamais côté client.
HEIWA_CLE=
# Identifiant public du site utilisé dans l'URL du lecteur (paramètre ?site=).
HEIWA_SITE=
# Badge « Sans publicité » : à 1, CineFlow demande un jeton sans publicité
# (GET /key/ad-free, valable 6 h, mis en cache côté serveur) et le transmet au
# lecteur. Laisser à 0 si le compte partenaire n'y a pas droit.
HEIWA_SANS_PUB=0

# --- API TMDB ---------------------------------------------------------------
# Clé API TMDB (v3) : https://www.themoviedb.org/settings/api
# Recommandée : affiches, logos, notes et liste des saisons. Sans elle, les
# fiches basculent sur l'API HeiwaStream (plus pauvres, pas de note TMDB).
TMDB_KEY=

# --- Connexion Discord OAuth2 ----------------------------------------------
# Application Discord > OAuth2 : https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Doit correspondre exactement à une URL de redirection déclarée dans l'application.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Secret de signature des cookies de session (obligatoire en production).
# Génère-le avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
